// Sanctuary materials. Baked ambient is additive so dynamic lights stay visible.

sanctuary/altar_marble
{
	{
		blend bumpmap
		map textures/sanctuary/altar_marble_n.tga
	}
	{
		blend diffusemap
		map textures/sanctuary/altar_marble_d.tga
	}
	{
		blend specularmap
		map textures/sanctuary/altar_marble_s.tga
		rgb 1.75
	}
	{
		blend add
		map textures/sanctuary/altar_marble_d.tga
		vertexColor
		rgb 0.25
	}
}

