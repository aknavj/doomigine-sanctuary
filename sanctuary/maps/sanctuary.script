void sanctuary_benchmark() {
	float started;
	if (busy == 1) { return; }
	busy = 1;
	menu_parm("bench_label", "Benchmark running");
	sys.println("SANCTUARY_BENCH_START");
	thread bench_counter();
	started = sys.getTime();
	play_cam($cam_0);
	play_cam($cam_1);
	play_cam($cam_2);
	play_cam($cam_3);
	play_cam($cam_4);
	play_cam($cam_5);
	play_cam($cam_6);
	play_cam($cam_7);
	play_cam($cam_8);
	finish_bench(started);
}

