void main() {
	sys.waitFrame();
	sunOn = 1;
	flameOn = 1;
	candleOn = 1;
	soundOn = 1;
	sys.setcvar("noclip", "1");
	thread fireballs();
	menu_parm("bench_label", "Choose Benchmark or a camera");
}
