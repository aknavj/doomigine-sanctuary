// Sanctuary benchmark controls. The world panel calls these.
float busy;
float fireballOn;
float sunOn;
float flameOn;
float candleOn;
float weaponOn;
float soundOn;
float benchFrames;
string savedVolume;

void menu_parm(string key, string value) {
	$sanctuary_menu.setGuiParm(key, value);
}

void apply_sun() {
	if (sunOn == 1 && fireballOn == 0) {
		$light_sun.show();
	} else {
		$light_sun.hide();
	}
}

void apply_flames() {
	if (flameOn == 1 && fireballOn == 0) {
		$light_flame_0.show();
		$light_flame_1.show();
		$particles_flame_0.show();
		$particles_flame_1.show();
		$particles_smoke_0.show();
		$particles_smoke_1.show();
	} else {
		$light_flame_0.hide();
		$light_flame_1.hide();
		$particles_flame_0.hide();
		$particles_flame_1.hide();
		$particles_smoke_0.hide();
		$particles_smoke_1.hide();
	}
}

void apply_candles() {
	if (candleOn == 1) {
		$light_candle_0.show();
		$light_candle_1.show();
		$particles_candle_0.show();
		$particles_candle_1.show();
	} else {
		$light_candle_0.hide();
		$light_candle_1.hide();
		$particles_candle_0.hide();
		$particles_candle_1.hide();
	}
}

void sanctuary_sun() {
	if (sunOn == 1) { sunOn = 0; menu_parm("sun_label", "Sun: off"); }
	else { sunOn = 1; menu_parm("sun_label", "Sun: on"); }
	apply_sun();
}
void sanctuary_flames() {
	if (flameOn == 1) { flameOn = 0; menu_parm("flame_label", "Flames: off"); }
	else { flameOn = 1; menu_parm("flame_label", "Flames: on"); }
	apply_flames();
}
void sanctuary_candles() {
	if (candleOn == 1) { candleOn = 0; menu_parm("candle_label", "Candles: off"); }
	else { candleOn = 1; menu_parm("candle_label", "Candles: on"); }
	apply_candles();
}
void sanctuary_weapon() {
	if (weaponOn == 1) { weaponOn = 0; $light_weapon.hide(); menu_parm("weapon_label", "Weapon: off"); }
	else { weaponOn = 1; $light_weapon.show(); menu_parm("weapon_label", "Weapon: on"); }
}
void sanctuary_sound() {
	if (soundOn == 1) {
		savedVolume = sys.getcvar("s_volume");
		sys.setcvar("s_volume", "-40");
		soundOn = 0;
		menu_parm("sound_label", "Sound: off");
	} else {
		sys.setcvar("s_volume", savedVolume);
		soundOn = 1;
		menu_parm("sound_label", "Sound: on");
	}
}
void sanctuary_fireballs() {
	if (fireballOn == 1) {
		fireballOn = 0;
		$light_fireball_0.hide();
		$light_fireball_1.hide();
		$particles_fireball_0.hide();
		$particles_fireball_1.hide();
		menu_parm("fireball_label", "Fireballs: off");
	} else {
		fireballOn = 1;
		$light_fireball_0.show();
		$light_fireball_1.show();
		$particles_fireball_0.show();
		$particles_fireball_1.show();
		menu_parm("fireball_label", "Fireballs: on");
	}
	apply_sun();
	apply_flames();
}
void sanctuary_tone_default() { sys.setcvar("r_brightness", "1"); sys.setcvar("r_gamma", "1"); menu_parm("tone_label", "Tone: default"); }
void sanctuary_tone_bright() { sys.setcvar("r_brightness", "1.35"); sys.setcvar("r_gamma", "1"); menu_parm("tone_label", "Tone: bright"); }
void sanctuary_tone_dim() { sys.setcvar("r_brightness", "0.7"); sys.setcvar("r_gamma", "1"); menu_parm("tone_label", "Tone: dim"); }
void sanctuary_tone_warm() { sys.setcvar("r_brightness", "1.1"); sys.setcvar("r_gamma", "1.25"); menu_parm("tone_label", "Tone: warm gamma"); }
void sanctuary_tone_cool() { sys.setcvar("r_brightness", "1"); sys.setcvar("r_gamma", "0.82"); menu_parm("tone_label", "Tone: cool gamma"); }
void sanctuary_quit() { menu_parm("bench_label", "Press Escape, then Exit Game"); sys.println("SANCTUARY_QUIT"); }

void play_cam(entity cam) {
	sys.fadeOut('0 0 0', 0.25);
	sys.wait(0.25);
	cam.start();
	sys.fadeIn('0 0 0', 0.45);
	sys.waitFor(cam);
}
void bench_counter() {
	benchFrames = 0;
	while (busy == 1) {
		benchFrames = benchFrames + 1;
		sys.waitFrame();
	}
}
void finish_bench(float started) {
	float elapsed;
	busy = 0;
	sys.waitFrame();
	elapsed = sys.getTime() - started;
	$sanctuary_menu.setGuiFloat("bench_seconds", elapsed);
	if (elapsed > 0) {
		$sanctuary_menu.setGuiFloat("bench_fps", benchFrames / elapsed);
	}
	menu_parm("bench_label", "Benchmark done");
	sys.println("SANCTUARY_BENCH_END");
}
void sanctuary_cam_0() {
	float started;
	if (busy == 1) { return; }
	busy = 1;
	menu_parm("bench_label", "Camera 0");
	thread bench_counter();
	started = sys.getTime();
	play_cam($cam_0);
	finish_bench(started);
}
