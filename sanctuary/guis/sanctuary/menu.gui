windowDef Desktop
{
	rect	0,0,640,480
	backcolor	0.04,0.03,0.025,1
	onTime 0
	{
		set "sun_label" "Sun: on" ;
		set "flame_label" "Flames: on" ;
		set "candle_label" "Candles: on" ;
		set "weapon_label" "Weapon: off" ;
		set "sound_label" "Sound: on" ;
		set "fireball_label" "Fireballs: off" ;
		set "tone_label" "Tone: default" ;
		set "bench_label" "Choose Benchmark or a camera" ;
